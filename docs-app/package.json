{
  "name": "@velkinvv/plainerv-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev-with-manifest.mjs",
    "dev:vite": "vite --port 6500",
    "content:manifest": "node ./scripts/build-content-manifest.mjs",
    "content:source:check": "node ./scripts/check-content-source-of-truth.mjs",
    "content:parity:check": "node ./scripts/check-content-parity.mjs",
    "docs:version:check": "node ./scripts/check-docs-version-sync.mjs",
    "docs:version:props": "node ./scripts/build-version-props.mjs",
    "docs:version:snapshots": "node ./scripts/capture-version-snapshots.mjs",
    "build": "npm run content:manifest && vite build && npm run prerender && npm run search:index",
    "analyze": "npm run content:manifest && vite build --mode analyze",
    "prerender": "node ./scripts/prerender.mjs",
    "search:index": "node ./scripts/build-search-index.mjs",
    "prefix:check": "node ./scripts/check-docs-prefix.mjs",
    "preview": "vite preview --port 6500",
    "manifest:check": "node ./scripts/check-manifest-fresh.mjs && npm run docs:version:check && npm run content:source:check && npm run content:parity:check",
    "sync:github-docs": "node ./scripts/sync-docs-from-github.mjs",
    "lhci": "node ./scripts/lighthouse-check.mjs"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@velkinvv/plainerv": "file:..",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-live": "^4.1.8",
    "react-router-dom": "^7.9.2",
    "satori": "^0.47.1",
    "styled-components": "^6.1.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.0",
    "@shikijs/rehype": "^4.4.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "chokidar": "^4.0.3",
    "lighthouse": "^12.8.2",
    "pagefind": "^1.5.2",
    "puppeteer": "^25.13.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.14.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "yaml": "^2.8.1"
  }
}
